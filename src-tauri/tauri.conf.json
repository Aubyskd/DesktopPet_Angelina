{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面宠物",
  "version": "1.1.1",
  "identifier": "com.desktoppet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "桌面宠物",
        "width": 320,
        "height": 320,
        "visible": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "桌宠设置",
        "width": 620,
        "height": 720,
        "visible": false,
        "center": true,
        "resizable": true,
        "minWidth": 500,
        "minHeight": 560
      },
      {
        "label": "memo",
        "title": "添加备忘录",
        "width": 440,
        "height": 430,
        "visible": false,
        "center": true,
        "resizable": false
      },
      {
        "label": "memo-display",
        "title": "桌宠备忘录",
        "width": 220,
        "height": 90,
        "visible": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      },
      {
        "label": "timer",
        "title": "设置专注时间",
        "width": 420,
        "height": 360,
        "visible": false,
        "center": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "轻量 Windows 桌面宠物",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
